{
  "name": "Entorno Django",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "batisteo.vscode-django"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate",
  "forwardPorts": [8000]
}